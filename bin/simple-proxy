#!/usr/bin/env bash
# ==============================================================================
# simple-proxy — 极简 HTTP 代理工具
#
#   simple-proxy on <cmd> [...]         让一条命令走代理（一次性：跑完自动停隧道）
#   simple-proxy on --start <cmd> [...]  同上，但隧道常驻（可连续跑多条命令）
#   simple-proxy off                    关闭代理（停止 mihomo）
#   simple-proxy status                 查看状态
#   simple-proxy check                  自检/诊断
#   simple-proxy logs                   查看最近的路由决策日志
#   simple-proxy update <URL>           更新订阅配置
#   simple-proxy install                安装/初始化
#   simple-proxy uninstall              卸载
#
# 设计原则见 docs/DESIGN.md
# ==============================================================================
set -uo pipefail

SP_SELF="${BASH_SOURCE[0]}"
SP_SCRIPT_DIR="$(cd "$(dirname "$SP_SELF")" && pwd)"
SP_REPO_DIR="$(cd "$SP_SCRIPT_DIR/.." && pwd)"

# 源码入口使用仓库资源，安装入口使用扁平化的数据目录资源。
_sp_asset() {
  local rel="$1" base c
  base="$(basename "$rel")"
  for c in "$SP_REPO_DIR/$rel" \
           "${SP_DATA_DIR:-$HOME/.local/share/simple-proxy}/$rel" \
           "${SP_DATA_DIR:-$HOME/.local/share/simple-proxy}/$base"; do
    [[ -r "$c" ]] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

# shellcheck source=lib/core.sh
. "$(_sp_asset lib/core.sh 2>/dev/null || echo "$SP_REPO_DIR/lib/core.sh")"

usage() {
  cat <<'EOF'
simple-proxy — 极简 HTTP 代理工具

用法:
  simple-proxy on <cmd> [args...]         让一条命令走代理（一次性）
  simple-proxy on --start <cmd> [args...]  同上，但隧道常驻
  simple-proxy off                        关闭代理
  simple-proxy status                     查看状态
  simple-proxy check                      自检/诊断
  simple-proxy logs [N]                   查看最近 N 行路由日志（默认 50）
  simple-proxy update <订阅URL>           更新订阅配置
  simple-proxy install [选项]             安装/初始化
  simple-proxy uninstall                  卸载

install 选项:
  --subscription <URL>   订阅地址（也可用环境变量 SIMPLE_PROXY_SUBSCRIPTION）
  --no-shell             不写入 shell 集成（不修改 ~/.zshrc / ~/.bashrc）
  --port <N>             HTTP 代理端口（默认 7890）
  --no-download          不下载 mihomo 内核（假设已自行安装）

shell 集成（可选，安装时写入）提供以下快捷命令:
  proxy-on  = simple-proxy on
  po = proxy-on
  proxy-off = simple-proxy off
  proxy-status = simple-proxy status
EOF
}

# ── on ───────────────────────────────────────────────────────────────────────
cmd_on() {
  sp_load_config || return 1
  exec python3 "$SP_RUNTIME" on "$@"
}

cmd_hold() {
  sp_load_config || return 1
  exec python3 "$SP_RUNTIME" hold "$@"
}

# ── off / status / logs ──────────────────────────────────────────────────────
cmd_off() {
  sp_load_config || return 1
  exec python3 "$SP_RUNTIME" off
}

cmd_status() {
  sp_load_config || return 1
  sp_status
}

cmd_logs() {
  sp_load_config || return 1
  local n="${1:-50}"
  if [[ ! -f "$SP_LOG_FILE" ]]; then
    echo "（还没有日志）" >&2
    return 0
  fi
  # 默认只看路由决策行，噪音更少
  grep '\[TCP\]' "$SP_LOG_FILE" 2>/dev/null | tail -n "$n" || tail -n "$n" "$SP_LOG_FILE"
}

cmd_check() {
  sp_load_config || return 1
  sp_check
}

# ── update ───────────────────────────────────────────────────────────────────
cmd_update() {
  sp_load_config || return 1
  local url="${1:-${SIMPLE_PROXY_SUBSCRIPTION:-}}"
  if [[ -z "$url" ]]; then
    echo "用法: simple-proxy update <订阅URL>" >&2
    return 1
  fi
  bash "$(_sp_asset scripts/update-subscription.sh)" "$url" "$SP_SUBSCRIPTION_CONFIG"
}

# ── install / uninstall ──────────────────────────────────────────────────────
cmd_install() {
  bash "$(_sp_asset install.sh)" "$@"
}

cmd_uninstall() {
  bash "$(_sp_asset uninstall.sh)" "$@"
}

# ── 入口 ─────────────────────────────────────────────────────────────────────
main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    on)      cmd_on "$@" ;;
    _hold)   cmd_hold "$@" ;;
    _kept)   sp_load_config && sp_runtime kept ;;
    off)     cmd_off "$@" ;;
    status)  cmd_status "$@" ;;
    check)   cmd_check "$@" ;;
    logs)    cmd_logs "$@" ;;
    update)  cmd_update "$@" ;;
    install) cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    help|-h|--help) usage ;;
    *) echo "未知命令: $cmd" >&2; usage >&2; return 1 ;;
  esac
}

main "$@"
